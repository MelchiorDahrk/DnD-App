rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function own(uid) { return signed() && request.auth.uid == uid; }
    function member(party) { return signed() && exists(/databases/$(database)/documents/parties/$(party)) && exists(/databases/$(database)/documents/parties/$(party)/members/$(request.auth.uid)); }
    function creator(party) { return signed() && get(/databases/$(database)/documents/parties/$(party)).data.ownerId == request.auth.uid; }
    function afterMember(party) { return signed() && existsAfter(/databases/$(database)/documents/parties/$(party)/members/$(request.auth.uid)); }
    function integer(n, low, high) { return n is int && n >= low && n <= high; }
    function text(s, max) { return s is string && s.size() <= max; }
    function partyPath(party) { return /databases/$(database)/documents/parties/$(party); }
    function characterPath(uid,id) { return /databases/$(database)/documents/users/$(uid)/characters/$(id); }
    function sharedPath(party,id) { return /databases/$(database)/documents/parties/$(party)/characters/$(id); }
    function memberPath(party,uid) { return /databases/$(database)/documents/parties/$(party)/members/$(uid); }
    function shopPath(party,shop) { return /databases/$(database)/documents/parties/$(party)/stores/$(shop); }
    function receiptPath(uid,character,id) { return /databases/$(database)/documents/users/$(uid)/characters/$(character)/shopReceipts/$(id); }
    function validOrderLine(line,order) {
      return line.catalogId==order.itemId && integer(line.priceCp,1,100000000) && order.unitCp==line.priceCp
        && integer(order.quantity,1,99999);
    }
    function stockChange(before,after,order) {
      let id=order.itemId;
      return before.open==true && (id in before.items) && (id in after.items)
        && after.diff(before).affectedKeys().hasOnly(['items','lastPurchase','revision'])
        && after.revision==before.revision+1 && after.items.diff(before.items).affectedKeys().hasOnly([id])
        && validOrderLine(before.items[id],order) && integer(before.items[id].stock,order.quantity,99999)
        && after.items[id].diff(before.items[id]).affectedKeys().hasOnly(['stock'])
        && after.items[id].stock==before.items[id].stock-order.quantity;
    }
    function validShop(data) {
      return data.keys().hasOnly(['name','type','description','multiplier','buyRate','acceptAll','open','items','revision','lastPurchase'])
        && text(data.name,100) && data.name.size()>0 && text(data.description,2000)
        && data.type in ['general','blacksmith','armorer','alchemist','arcane','scribe','jeweler','stables','outfitter','magic']
        && integer(data.multiplier,1,1000) && integer(data.buyRate,0,100)
        && data.acceptAll is bool && data.open is bool && data.items is map && data.items.size()<=100
        && integer(data.revision,1,2147483647) && data.lastPurchase==null;
    }
    function validDM(party,dm) {
      return dm is map && dm.keys().hasOnly(['ownerId','characterId','sharedId']) && dm.keys().size()==3
        && text(dm.ownerId,128) && dm.ownerId.size()>0 && dm.characterId.matches('[a-zA-Z0-9_-]{1,100}')
        && dm.sharedId==dm.ownerId+'_'+dm.characterId
        && exists(memberPath(party,dm.ownerId)) && exists(sharedPath(party,dm.sharedId))
        && get(sharedPath(party,dm.sharedId)).data.ownerId==dm.ownerId
        && get(sharedPath(party,dm.sharedId)).data.characterId==dm.characterId
        && exists(characterPath(dm.ownerId,dm.characterId)) && get(characterPath(dm.ownerId,dm.characterId)).data.partyId==party
        && get(characterPath(dm.ownerId,dm.characterId)).data.deleted==false;
    }
    function dungeonMaster(party) {
      let root=get(partyPath(party)).data;
      let assignment=root.get('dm',null);
      return member(party) && request.auth.uid==(validDM(party,assignment)?assignment.ownerId:root.ownerId);
    }
    function assignmentCleared(party,key,value) {
      return !existsAfter(partyPath(party)) || getAfter(partyPath(party)).data.get('dm',{})==null
        || getAfter(partyPath(party)).data.get('dm',{}).get(key,'')!=value;
    }
    function manifest(d, uid) {
      return d.keys().hasAll(['ownerId','name','revision','chunks','partyId','deleted'])
        && d.keys().hasOnly(['ownerId','name','revision','chunks','partyId','deleted'])
        && d.ownerId == uid && text(d.name,120) && d.name.size()>0
        && integer(d.revision,1,2147483647) && integer(d.chunks,1,34)
        && text(d.partyId,100) && d.deleted is bool;
    }
    function liveShape(d) {
      return d.keys().hasAll(['hp','maxHp','tempHp','conditions','exhaustion','deathSuccess','deathFailure','inspiration','concentration','hitDice','slotUses','slotMax','featureUses','featureMax','revision'])
        && d.keys().hasOnly(['hp','maxHp','tempHp','conditions','exhaustion','deathSuccess','deathFailure','inspiration','concentration','hitDice','hitDicePools','slotUses','slotMax','pactSlot','featureUses','featureMax','revision'])
        && integer(d.revision,1,2147483647);
    }
    function liveVitals(d) {
      return integer(d.maxHp,1,9999) && integer(d.hp,0,d.maxHp) && integer(d.tempHp,0,9999)
        && integer(d.exhaustion,0,6) && integer(d.deathSuccess,0,3) && integer(d.deathFailure,0,3)
        && integer(d.inspiration,0,999) && text(d.concentration,500)
        && d.conditions is list && d.conditions.size()<=14
        && d.conditions.hasOnly(['Blinded','Charmed','Deafened','Frightened','Grappled','Incapacitated','Invisible','Paralyzed','Petrified','Poisoned','Prone','Restrained','Stunned','Unconscious']);
    }
    function liveDice(d) {
      return integer(d.hitDice,0,20) && (!('hitDicePools' in d) || validHitDicePools(d.hitDicePools,d.hitDice));
    }
    function liveSlots(uses,max) {
      return uses is list && uses.size()==9 && max is list && max.size()==9
        && integer(max[0],0,99) && integer(max[1],0,99) && integer(max[2],0,99)
        && integer(max[3],0,99) && integer(max[4],0,99) && integer(max[5],0,99)
        && integer(max[6],0,99) && integer(max[7],0,99) && integer(max[8],0,99)
        && integer(uses[0],0,max[0]) && integer(uses[1],0,max[1]) && integer(uses[2],0,max[2])
        && integer(uses[3],0,max[3]) && integer(uses[4],0,max[4]) && integer(uses[5],0,max[5])
        && integer(uses[6],0,max[6]) && integer(uses[7],0,max[7]) && integer(uses[8],0,max[8]);
    }
    function livePact(d) {
      return !('pactSlot' in d) || (d.pactSlot is map && d.pactSlot.keys().hasOnly(['level','max','used'])
        && integer(d.pactSlot.level,1,9) && integer(d.pactSlot.max,0,99) && integer(d.pactSlot.used,0,d.pactSlot.max));
    }
    function liveFeatures(d) {
      return d.featureUses is map && d.featureUses.size()<=2000 && d.featureMax is map && d.featureMax.size()<=2000;
    }
    function live(d) {
      return liveShape(d) && liveVitals(d) && liveDice(d) && liveSlots(d.slotUses,d.slotMax) && livePact(d) && liveFeatures(d);
    }
    function liveUpdate(before,after) {
      let changed=after.diff(before).affectedKeys();
      return liveShape(after)
        && (!changed.hasAny(['hp','maxHp','tempHp','conditions','exhaustion','deathSuccess','deathFailure','inspiration','concentration']) || liveVitals(after))
        && (!changed.hasAny(['hitDice','hitDicePools']) || liveDice(after))
        && (!changed.hasAny(['slotUses','slotMax']) || liveSlots(after.slotUses,after.slotMax))
        && (!changed.hasAny(['pactSlot']) || livePact(after))
        && (!changed.hasAny(['featureUses','featureMax']) || liveFeatures(after));
    }
    match /users/{uid}/characters/{id} {
      allow read: if own(uid);
      allow create: if own(uid) && id.matches('[a-zA-Z0-9_-]{1,100}') && manifest(request.resource.data,uid)
        && request.resource.data.revision==1 && request.resource.data.partyId=='' && request.resource.data.deleted==false;
      allow update: if own(uid) && manifest(request.resource.data,uid)
        && request.resource.data.ownerId==resource.data.ownerId
        && request.resource.data.revision==resource.data.revision+1
        && (!resource.data.deleted || request.resource.data.deleted)
        && (request.resource.data.partyId==resource.data.partyId || request.resource.data.partyId=='' || member(request.resource.data.partyId))
        && (resource.data.partyId=='' || (!request.resource.data.deleted && request.resource.data.partyId==resource.data.partyId)
          || !exists(memberPath(resource.data.partyId,uid)) || !exists(partyPath(resource.data.partyId))
          || !existsAfter(sharedPath(resource.data.partyId,uid+'_'+id)));
      match /content/{index} {
        allow read: if own(uid);
        allow create, update: if own(uid) && index.matches('[0-9]{1,2}')
          && request.resource.data.keys().hasOnly(['json']) && text(request.resource.data.json,240000)
          && getAfter(/databases/$(database)/documents/users/$(uid)/characters/$(id)).data.ownerId==uid;
        allow delete: if own(uid);
      }
      match /state/{stateId} {
        allow read: if own(uid);
        allow create: if own(uid) && stateId=='live' && live(request.resource.data) && request.resource.data.revision==1
          && getAfter(/databases/$(database)/documents/users/$(uid)/characters/$(id)).data.ownerId==uid;
        allow update: if own(uid) && stateId=='live' && liveUpdate(resource.data,request.resource.data)
          && request.resource.data.revision==resource.data.revision+1;
        allow delete: if own(uid) && stateId=='live'
          && getAfter(/databases/$(database)/documents/users/$(uid)/characters/$(id)).data.deleted==true;
      }
      match /operations/{operationId} {
        allow read: if own(uid);
        allow create: if own(uid) && request.resource.data.keys().hasOnly(['operationId','createdAt'])
          && request.resource.data.operationId==operationId && request.resource.data.createdAt==request.time;
      }
      match /shopReceipts/{orderId} {
        function isBuy(order,path) {
          let shop=get(path).data;
          return (order.itemId in shop.items) && validOrderLine(shop.items[order.itemId],order)
            && (shop.items[order.itemId].stock==null || (
              getAfter(path).data.lastPurchase=={'uid':uid,'characterId':id,'id':orderId}
              && stockChange(shop,getAfter(path).data,order)));
        }
        function shopOrder(order) {
          let path=shopPath(order.partyId,order.storeId);
          let previous=get(characterPath(uid,id)).data;
          let next=getAfter(characterPath(uid,id)).data;
          let shared=get(sharedPath(order.partyId,uid+'_'+id)).data;
          return member(order.partyId) && get(path).data.open==true
            && previous.deleted==false && previous.partyId==order.partyId && next.partyId==previous.partyId
            && next.deleted==false && next.revision==previous.revision+1
            && shared.ownerId==uid && shared.characterId==id
            && (order.kind=='sell' || isBuy(order,path));
        }
        allow get: if own(uid);
        allow create: if own(uid) && orderId.matches('[a-zA-Z0-9_-]{1,100}')
          && request.resource.data.keys().hasOnly(['partyId','storeId','kind','itemId','quantity','unitCp','createdAt'])
          && request.resource.data.partyId.matches('[a-zA-Z0-9_-]{1,100}')
          && request.resource.data.storeId.matches('[a-zA-Z0-9_-]{1,100}')
          && text(request.resource.data.itemId,200) && request.resource.data.itemId.size()>0
          && request.resource.data.kind in ['buy','sell']
          && integer(request.resource.data.quantity,1,99999) && integer(request.resource.data.unitCp,1,100000000)
          && request.resource.data.createdAt==request.time && shopOrder(request.resource.data);
      }
    }
    match /users/{uid}/parties/{party} {
      allow read, delete: if own(uid);
      allow create, update: if own(uid) && request.resource.data.keys().hasOnly(['partyId'])
        && request.resource.data.partyId==party && afterMember(party);
    }
    match /users/{uid}/escrow/{offer} {
      allow read, delete: if own(uid);
      allow create: if own(uid) && request.resource.data.keys().hasOnly(['partyId','characterId','refund'])
        && text(request.resource.data.refund,120000)
        && getAfter(/databases/$(database)/documents/parties/$(request.resource.data.partyId)/transfers/$(offer)).data.senderId==uid;
    }
    match /parties/{party} {
      allow get: if signed() && exists(/databases/$(database)/documents/parties/$(party)/members/$(request.auth.uid));
      allow create: if signed() && request.resource.data.keys().hasOnly(['ownerId','name','createdAt'])
        && request.resource.data.ownerId==request.auth.uid && text(request.resource.data.name,100)
        && request.resource.data.name.size()>0 && request.resource.data.createdAt==request.time;
      allow update: if creator(party) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && text(request.resource.data.name,100) && request.resource.data.name.size()>0;
      allow update: if creator(party) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId','dm'])
        && request.resource.data.ownerId!=resource.data.ownerId
        && (request.resource.data.get('dm',null)==resource.data.get('dm',null)
          || (request.resource.data.get('dm',null)==null && !existsAfter(memberPath(party,request.auth.uid))))
        && text(request.resource.data.ownerId,128)
        && existsAfter(/databases/$(database)/documents/parties/$(party)/members/$(request.resource.data.ownerId));
      allow update: if signed() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dm'])
        && ((creator(party) && (request.resource.data.get('dm',null)==null || validDM(party,request.resource.data.dm)))
          || (request.resource.data.get('dm',null)==null && resource.data.get('dm',null)!=null
            && resource.data.dm.ownerId==request.auth.uid
            && (!existsAfter(sharedPath(party,resource.data.dm.sharedId)) || !existsAfter(memberPath(party,request.auth.uid)))));
      allow delete: if creator(party);
      match /stores/{shop} {
        function purchase() {
          let marker=request.resource.data.lastPurchase;
          let path=receiptPath(request.auth.uid,marker.characterId,marker.id);
          let order=getAfter(path).data;
          return marker=={'uid':request.auth.uid,'characterId':marker.characterId,'id':marker.id}
            && !exists(path) && order.kind=='buy' && order.partyId==party && order.storeId==shop
            && order.createdAt==request.time && stockChange(resource.data,request.resource.data,order);
        }
        allow read: if member(party) && (dungeonMaster(party) || resource.data.open==true);
        allow create: if dungeonMaster(party) && shop.matches('[a-zA-Z0-9_-]{1,100}')
          && validShop(request.resource.data) && request.resource.data.revision==1;
        allow update: if (dungeonMaster(party) && validShop(request.resource.data)
            && request.resource.data.revision==resource.data.revision+1)
          || (member(party) && purchase());
        allow delete: if dungeonMaster(party);
      }
      match /session/combat {
        function publicEncounterPath() {
          return /databases/$(database)/documents/parties/$(party)/session/encounter;
        }
        function resetCombat() {
          return request.resource.data.scores=={} && request.resource.data.modifiers=={}
            && request.resource.data.current=='' && request.resource.data.round==1
            && request.resource.data.initiativeCharacter==''
            && (!request.resource.data.get('managed',false)
              || getAfter(publicEncounterPath()).data.runId==request.resource.data.encounterId);
        }
        function ownInitiative() {
          let id=request.resource.data.initiativeCharacter;
          return id!='' && request.resource.data.active && resource.data.active
            && request.resource.data.encounterId==resource.data.get('encounterId','')
            && request.resource.data.get('managed',false)==resource.data.get('managed',false)
            && request.resource.data.current==resource.data.current && request.resource.data.round==resource.data.round
            && get(/databases/$(database)/documents/parties/$(party)/characters/$(id)).data.ownerId==request.auth.uid
            && request.resource.data.scores.diff(resource.data.scores).affectedKeys().hasOnly([id])
            && integer(request.resource.data.scores[id],-999,999)
            && request.resource.data.modifiers.diff(resource.data.get('modifiers',{})).affectedKeys().hasOnly([id])
            && (! (id in request.resource.data.modifiers) || integer(request.resource.data.modifiers[id],-99,99));
        }
        function advanceCombat() {
          return request.resource.data.initiativeCharacter=='' && request.resource.data.active && resource.data.active
            && request.resource.data.encounterId==resource.data.get('encounterId','')
            && request.resource.data.get('managed',false)==resource.data.get('managed',false)
            && (!request.resource.data.get('managed',false) || getAfter(publicEncounterPath()).data.status=='active')
            && request.resource.data.scores==resource.data.scores
            && request.resource.data.modifiers==resource.data.get('modifiers',{});
        }
        function validCombat() {
          return request.resource.data.keys().hasOnly(['scores','modifiers','current','round','active','updatedBy','encounterId','initiativeCharacter','managed'])
            && request.resource.data.scores is map && request.resource.data.scores.size()<=100
            && request.resource.data.modifiers is map && request.resource.data.modifiers.size()<=100
            && text(request.resource.data.current,230) && integer(request.resource.data.round,1,1000000)
            && text(request.resource.data.encounterId,100) && text(request.resource.data.initiativeCharacter,230)
            && (!('managed' in request.resource.data) || (request.resource.data.managed==true && request.resource.data.active))
            && request.resource.data.active is bool && request.resource.data.updatedBy==request.auth.uid;
        }
        allow read: if member(party);
        allow create: if dungeonMaster(party) && validCombat() && resetCombat();
        allow update: if member(party) && validCombat()
          && (ownInitiative() || (dungeonMaster(party) && (advanceCombat()
            || (resetCombat() && ((!request.resource.data.active && (!resource.data.get('managed',false) || !existsAfter(publicEncounterPath())))
              || (!resource.data.active && request.resource.data.encounterId!=resource.data.get('encounterId','')))))));
      }
      match /encounters/{id} {
        function validDefinition() {
          let data=request.resource.data;
          return id.matches('[a-zA-Z0-9_-]{1,100}') && data.keys().hasOnly(['name','status','revision','payload'])
            && text(data.name,120) && data.name.size()>0 && text(data.payload,600000)
            && data.status in ['prepared','active','paused','completed','archived']
            && integer(data.revision,1,2147483647);
        }
        allow read: if dungeonMaster(party);
        allow create: if dungeonMaster(party) && validDefinition()
          && request.resource.data.revision==1 && request.resource.data.status=='prepared';
        allow update: if dungeonMaster(party) && validDefinition()
          && request.resource.data.revision==resource.data.revision+1;
        allow delete: if dungeonMaster(party) && resource.data.status in ['prepared','completed','archived'];
      }
      match /creatureTemplates/{id} {
        function validTemplate() {
          let data=request.resource.data;
          return id.matches('[a-zA-Z0-9_-]{1,100}') && data.keys().hasOnly(['name','payload','revision'])
            && text(data.name,120) && data.name.size()>0 && text(data.payload,600000)
            && integer(data.revision,1,2147483647);
        }
        allow read, delete: if dungeonMaster(party);
        allow create: if dungeonMaster(party) && validTemplate() && request.resource.data.revision==1;
        allow update: if dungeonMaster(party) && validTemplate() && request.resource.data.revision==resource.data.revision+1;
      }
      match /session/encounter {
        allow read: if member(party);
        allow create, update: if dungeonMaster(party)
          && request.resource.data.keys().hasOnly(['id','runId','status','creatures','current','started'])
          && request.resource.data.id.matches('[a-zA-Z0-9_-]{1,100}') && text(request.resource.data.runId,100)
          && request.resource.data.status in ['active','paused'] && text(request.resource.data.current,100)
          && request.resource.data.creatures is list && request.resource.data.creatures.size()<=30
          && request.resource.data.started is bool
          && getAfter(/databases/$(database)/documents/parties/$(party)/session/combat).data.encounterId==request.resource.data.runId
          && getAfter(/databases/$(database)/documents/parties/$(party)/session/combat).data.managed==true;
        allow delete: if dungeonMaster(party)
          && getAfter(/databases/$(database)/documents/parties/$(party)/session/combat).data.active==false;
      }
      match /encounterInbox/{uid}/hits/{hit} {
        allow read: if own(uid) && member(party);
        allow create: if dungeonMaster(party) && exists(memberPath(party,uid))
          && request.resource.data.keys().hasOnly(['actorId','createdAt','characterId','source','amount','damageType','acknowledged'])
          && request.resource.data.actorId==request.auth.uid && request.resource.data.createdAt==request.time
          && request.resource.data.characterId.matches('[a-zA-Z0-9_-]{1,100}')
          && get(sharedPath(party,uid+'_'+request.resource.data.characterId)).data.ownerId==uid
          && text(request.resource.data.source,120) && integer(request.resource.data.amount,1,9999)
          && text(request.resource.data.damageType,60) && request.resource.data.acknowledged==false;
        allow update: if own(uid) && member(party)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledged'])
          && request.resource.data.acknowledged==true;
      }
      match /activities/{event} {
        allow read: if member(party);
        allow create: if member(party) && request.resource.data.actorId==request.auth.uid
          && request.resource.data.keys().hasOnly(['actorId','createdAt','kind','text','characterId','name','result'])
          && request.resource.data.createdAt==request.time
          && (request.resource.data.kind in ['damage','healing','unconscious','inspiration','condition','roll']
            || (request.resource.data.kind=='encounter' && dungeonMaster(party)))
          && text(request.resource.data.characterId,100) && text(request.resource.data.name,120)
          && (!('text' in request.resource.data) || text(request.resource.data.text,1000))
          && (!('result' in request.resource.data) || text(request.resource.data.result,4000));
      }
      match /rests/{rest} {
        allow read: if member(party);
        allow create: if dungeonMaster(party) && request.resource.data.keys().hasOnly(['kind','actorId','characterId','createdAt'])
          && request.resource.data.kind in ['short','long'] && request.resource.data.actorId==request.auth.uid
          && text(request.resource.data.characterId,100) && request.resource.data.createdAt==request.time;
        match /replies/{uid} {
          allow read: if member(party);
          allow create: if own(uid) && member(party) && exists(/databases/$(database)/documents/parties/$(party)/rests/$(rest))
            && request.resource.data.keys().hasOnly(['yes','characterId','actorId']) && request.resource.data.yes is bool
            && request.resource.data.actorId==uid && text(request.resource.data.characterId,100);
        }
      }
      match /transfers/{offer} {
        function changedSheet(uid,id) {
          return getAfter(/databases/$(database)/documents/users/$(uid)/characters/$(id)).data.revision
            ==get(/databases/$(database)/documents/users/$(uid)/characters/$(id)).data.revision+1;
        }
        allow list: if member(party);
        allow get: if member(party) || (signed() && request.auth.uid in [resource.data.senderId,resource.data.recipientId]);
        allow create: if member(party) && request.resource.data.keys().hasOnly(['senderId','recipientId','fromCharacter','toCharacter','fromName','toName','payload','status','createdAt'])
          && request.resource.data.senderId==request.auth.uid && request.resource.data.recipientId!=request.auth.uid
          && exists(/databases/$(database)/documents/parties/$(party)/members/$(request.resource.data.recipientId))
          && get(/databases/$(database)/documents/parties/$(party)/characters/$(request.resource.data.recipientId+'_'+request.resource.data.toCharacter)).data.ownerId==request.resource.data.recipientId
          && get(/databases/$(database)/documents/users/$(request.auth.uid)/characters/$(request.resource.data.fromCharacter)).data.partyId==party
          && text(request.resource.data.payload,40000) && text(request.resource.data.fromName,120) && text(request.resource.data.toName,120)
          && request.resource.data.status=='pending' && request.resource.data.createdAt==request.time
          && changedSheet(request.auth.uid,request.resource.data.fromCharacter)
          && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/escrow/$(offer));
        allow update: if signed() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && (
          (member(party) && request.auth.uid==resource.data.recipientId && resource.data.status=='pending'
            && exists(/databases/$(database)/documents/parties/$(party)/members/$(resource.data.senderId))
            && (request.resource.data.status=='declined' || (request.resource.data.status=='accepted'
              && get(/databases/$(database)/documents/users/$(request.auth.uid)/characters/$(resource.data.toCharacter)).data.partyId==party
              && changedSheet(request.auth.uid,resource.data.toCharacter))))
          || (request.auth.uid==resource.data.senderId && resource.data.status in ['pending','declined']
            && request.resource.data.status=='refunded' && changedSheet(request.auth.uid,resource.data.fromCharacter)
            && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/escrow/$(offer)))
        );
      }
      match /members/{uid} {
        // A prospective member may read only their own membership, never the roster.
        allow get: if own(uid) || member(party);
        allow list: if member(party);
        allow create: if own(uid) && request.resource.data.keys().hasOnly(['uid','displayName','invitation','joinedAt'])
          && request.resource.data.uid==uid && text(request.resource.data.displayName,254)
          && request.resource.data.joinedAt==request.time
          && (getAfter(/databases/$(database)/documents/parties/$(party)).data.ownerId==uid
              || validInvitation(party,request.resource.data.invitation));
        allow delete: if (own(uid) || creator(party))
          && assignmentCleared(party,'ownerId',uid)
          && (!existsAfter(/databases/$(database)/documents/parties/$(party))
              || getAfter(/databases/$(database)/documents/parties/$(party)).data.ownerId!=uid);
      }
      match /invitations/{token} {
        allow read: if creator(party);
        allow create, update: if creator(party) && request.resource.data.keys().hasOnly(['token','createdAt','revoked'])
          && request.resource.data.token==token
          && request.resource.data.revoked==getAfter(/databases/$(database)/documents/invitations/$(token)).data.revoked
          && request.resource.data.createdAt==getAfter(/databases/$(database)/documents/invitations/$(token)).data.createdAt
          && getAfter(/databases/$(database)/documents/invitations/$(token)).data.partyId==party;
      }
      match /characters/{sharedId} {
        allow read: if member(party);
        allow create, update: if signed() && request.resource.data.keys().hasOnly(['ownerId','characterId','sheet','chunks','detailsHash','sheetHash'])
          && request.resource.data.ownerId==request.auth.uid && member(party)
          && sharedId==request.auth.uid+'_'+request.resource.data.characterId
          && publicSheet(request.resource.data.sheet,request.resource.data.characterId)
          && integer(request.resource.data.chunks,1,34) && request.resource.data.detailsHash.matches('[a-f0-9]{64}')
          && request.resource.data.sheetHash.matches('[a-f0-9]{64}')
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/characters/$(request.resource.data.characterId)).data.partyId==party
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/characters/$(request.resource.data.characterId)).data.deleted==false
          && (!exists(/databases/$(database)/documents/parties/$(party)/characters/$(sharedId)) || resource.data.ownerId==request.auth.uid);
        allow delete: if signed() && (resource.data.ownerId==request.auth.uid || creator(party))
          && assignmentCleared(party,'sharedId',sharedId);
        match /sheet/{index} {
          allow read: if member(party);
          allow create, update: if member(party) && index.matches('[0-9]{1,2}')
            && request.resource.data.keys().hasOnly(['json']) && text(request.resource.data.json,240000)
            && getAfter(/databases/$(database)/documents/parties/$(party)/characters/$(sharedId)).data.ownerId==request.auth.uid;
          allow delete: if signed() && (get(/databases/$(database)/documents/parties/$(party)/characters/$(sharedId)).data.ownerId==request.auth.uid || creator(party));
        }
        match /state/{stateId} {
          allow read: if member(party);
          // The private live document already enforces the schema. The public
          // copy must match it exactly within the same transaction.
          allow create, update: if stateId=='live' && member(party)
            && getAfter(/databases/$(database)/documents/parties/$(party)/characters/$(sharedId)).data.ownerId==request.auth.uid
            && request.resource.data==getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/characters/$(getAfter(/databases/$(database)/documents/parties/$(party)/characters/$(sharedId)).data.characterId)/state/live).data;
          allow delete: if signed() && (get(/databases/$(database)/documents/parties/$(party)/characters/$(sharedId)).data.ownerId==request.auth.uid || creator(party));
        }
      }
    }
    function validHitDicePools(pools,total) {
      let d6=pools.get('6',0);
      let d8=pools.get('8',0);
      let d10=pools.get('10',0);
      let d12=pools.get('12',0);
      return pools is map && pools.size()>0 && pools.keys().hasOnly(['6','8','10','12'])
        && integer(d6,0,20) && integer(d8,0,20) && integer(d10,0,20) && integer(d12,0,20)
        && d6+d8+d10+d12==total;
    }
    function publicSheet(d,id) {
      return d.keys().hasOnly(['id','name','playerName','class','subclass','level','classBreakdown','race','ac','portrait','slots','features','skillBonuses','initiative','initiativeMode'])
        && (!('classBreakdown' in d) || text(d.classBreakdown,250))
        && (!('skillBonuses' in d) || (d.skillBonuses is map && d.skillBonuses.size()<=18))
        && (!('initiative' in d) || integer(d.initiative,-199,199))
        && (!('initiativeMode' in d) || d.initiativeMode in ['normal','advantage','disadvantage'])
        && d.id==id && text(d.name,120) && text(d.playerName,120) && text(d.class,100)
        && text(d.subclass,500) && integer(d.level,1,20) && text(d.race,500) && integer(d.ac,-99,100000000)
        && (d.portrait==null || (d.portrait is map && d.portrait.keys().hasOnly(['image','design']) && text(d.portrait.image,180000)))
        && d.slots is list && d.slots.size()==9 && d.features is list && d.features.size()<=2000;
    }
    function validInvitation(party,token) {
      let invite=get(/databases/$(database)/documents/invitations/$(token));
      return token is string && token.matches('[a-f0-9]{64}') && invite.data.partyId==party
        && invite.data.revoked==false && invite.data.createdAt+duration.value(7,'d')>request.time
        && exists(/databases/$(database)/documents/parties/$(party));
    }
    match /invitations/{token} {
      allow get: if signed() && token.matches('[a-f0-9]{64}');
      allow create: if signed() && token.matches('[a-f0-9]{64}')
        && request.resource.data.keys().hasOnly(['partyId','creatorId','createdAt','revoked'])
        && creator(request.resource.data.partyId) && request.resource.data.creatorId==request.auth.uid
        && request.resource.data.revoked==false && request.resource.data.createdAt==request.time;
      allow update: if creator(resource.data.partyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked']) && request.resource.data.revoked==true;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
